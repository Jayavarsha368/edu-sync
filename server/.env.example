# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/edu-sync
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/edu-sync
MONGO_URI=mongodb://127.0.0.1:27017/edu-sync

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Set to "openai" to use OpenAI, or "ollama" to use a local Ollama server.
# If AI_PROVIDER=ollama and Ollama fails, the server automatically falls back
# to OpenAI if OPENAI_API_KEY is set.
AI_PROVIDER=ollama

# ─── OpenAI (optional if using Ollama) ───────────────────────────────────────
OPENAI_API_KEY=sk-proj-...your-key-here...
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── Ollama (optional if using OpenAI) ───────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434/api/chat
LOCAL_AI_MODEL=llama3.2:3b
